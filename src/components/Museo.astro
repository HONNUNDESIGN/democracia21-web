---
// "03 Museo" / "hacia delante": declaración de marca a pantalla completa.
//
// Change-order (feedback socios, ver PPT): fuera el efecto de texto 3D
// ("las frases cóncavas") y las tarjetas-sello que venían después — pedían
// "algo más visual, que no sean tarjetas y quizá más color", con solo 3
// mensajes directos. Sustituye a la reconstrucción anterior (React Bits Pro
// "3D Text Reveal", archivada en _archive/v4-descartado/).
//
// Técnica: mismo patrón sticky-stack ya probado en Pilares.astro (position:
// sticky, sin pin de GSAP, sin ScrollTrigger.create con `pin`) — cada bloque
// de color cubre al anterior según se hace scroll. Cero JS necesario para el
// apilado en sí; GSAP solo hace un fade/rise de entrada por bloque.
import logoBlack from '@/assets/brand/logo-black.svg?raw';

const panels = [
  {
    bg: 'bg-ink',
    text: 'text-lime',
    copy: 'Venimos a unir, no a dividir.',
    fontSize: 'clamp(2.2rem, 6.4vw, 5rem)',
    photo: true,
  },
  {
    bg: 'bg-lime',
    text: 'text-ink',
    stat: '13M',
    copy: 'votantes que ya no se sienten representados por nadie.',
    fontSize: 'clamp(1.5rem, 4.4vw, 3rem)',
  },
  {
    bg: 'bg-turquesa',
    text: 'text-ink',
    stat: '60%',
    copy: 'cree que el bipartidismo es un problema.',
    fontSize: 'clamp(1.5rem, 4.4vw, 3rem)',
  },
] as const;
---

<section id="museo" class="relative bg-lime" data-museo>
  <div class="px-5 pb-[9vh] pt-[14vh] md:px-8 md:pb-[11vh]">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
      <div class="text-ink" style="width: clamp(2.5rem, 7vw, 4rem);" set:html={logoBlack} />
      <p class="display text-ink" style="font-size: clamp(1.6rem, 4.6vw, 3rem);">
        no mira a la derecha ni a la izquierda,<br class="hidden sm:block" /> mira hacia delante.
      </p>
    </div>
  </div>

  <div class="relative" data-museo-stack>
    {
      panels.map((panel, i) => (
        <article
          class:list={['museo-panel', panel.bg, panel.text]}
          style={`z-index: ${i + 1};`}
          data-museo-panel
        >
          <div
            class="relative z-10 mx-auto flex w-full max-w-4xl flex-col items-center gap-5 px-6 text-center md:px-10"
            data-museo-panel-inner
          >
            {'stat' in panel && panel.stat && (
              <span class="text-stroke select-none" style="font-size: clamp(5.5rem, 20vw, 14rem); line-height: 0.8;" aria-hidden="true">
                {panel.stat}
              </span>
            )}
            <p class="display" style={`font-size: ${panel.fontSize};`}>
              {'stat' in panel && panel.stat && <span class="sr-only">{panel.stat} </span>}
              {panel.copy}
            </p>
          </div>

          {'photo' in panel && panel.photo && (
            <div
              class="pointer-events-none absolute bottom-0 left-3 z-0 w-[24vw] max-w-[17rem] min-w-[8.5rem] sm:block md:left-6 md:w-[19vw]"
              aria-hidden="true"
            >
              <img
                src="/img/museo-pareja.webp"
                alt=""
                loading="lazy"
                decoding="async"
                class="block h-auto w-full object-contain"
                onerror="this.parentElement.style.display='none'"
              />
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .museo-panel {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .museo-panel {
      will-change: auto;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from '@/lib/motion';

  const panels = gsap.utils.toArray<HTMLElement>('[data-museo-panel]');

  if (panels.length) {
    const mm = gsap.matchMedia();

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const cleanups: HTMLElement[] = [];

      panels.forEach((panel) => {
        const inner = panel.querySelector<HTMLElement>('[data-museo-panel-inner]');
        if (!inner) return;
        cleanups.push(inner);

        gsap.set(inner, { opacity: 0, y: 28 });
        ScrollTrigger.create({
          trigger: panel,
          start: 'top top+=120',
          once: true,
          onEnter: () => gsap.to(inner, { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out' }),
        });
      });

      return () => {
        cleanups.forEach((inner) => gsap.set(inner, { clearProps: 'opacity,transform' }));
      };
    });

    ScrollTrigger.refresh();
  }
</script>
